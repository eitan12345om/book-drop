PORT=3001
UPLOAD_DIR=uploads
EXPIRE_DELAY_MS=300000
MAX_EXPIRE_MS=3600000
MAX_FILE_SIZE=104857600
MAX_DISK_BYTES=1073741824
MAX_FILES_PER_KEY=5
MAX_URLS_PER_KEY=20
MAX_KEYS_PER_IP=3
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20
LOG_LEVEL=info
GOOGLE_BOOKS_API_KEY=
# kepubify | calibre
KOBO_CONVERTER=kepubify
# calibre | kindlegen
KINDLE_CONVERTER=calibre
# azw3 | mobi (calibre only; kindlegen always writes MOBI)
KINDLE_OUTPUT_FORMAT=azw3
# Container resource limits, read both by docker-compose.yaml and by the app itself.
# Allow around 250 MB per concurrent conversion, so raise MEM_LIMIT alongside CPUS.
CPUS=1.0
MEM_LIMIT=2g

# Conversions run at most this many at a time; the rest queue, briefly. Left unset,
# these follow CPUS above (capped at 4) and twice that many queued. Raising the limit
# past the CPU count does not add throughput, since conversions are CPU-bound.
# MAX_CONCURRENT_CONVERSIONS=2
# MAX_QUEUED_CONVERSIONS=4
# Behind Cloudflare an upload must be answered within 100 s. Metadata lookup (15 s), the
# wait for a slot, and the conversion itself add up to 90 s with these defaults, so on a
# slow host lower MAX_QUEUED_CONVERSIONS rather than raising either of these.
MAX_CONVERSION_WAIT_MS=20000
CONVERSION_TIMEOUT_MS=55000
